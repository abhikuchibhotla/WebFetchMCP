{
  "name": "webfetch-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A stateless MCP server that searches the web and returns readable, token-efficient web-page context for local LLMs.",
  "type": "module",
  "bin": {
    "webfetch-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/**/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "cheerio": "^1.1.2",
    "turndown": "^7.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
