# Free default: static DuckDuckGo web results. It needs no account or key.
SEARCH_PROVIDER=duckduckgo-html

# Optional ordered fallback chain. Providers are tried once, then the server
# returns a research handoff instead of retrying endlessly. A self-hosted
# SearXNG instance is the best no-key fallback for a DGX/laptop setup.
# SEARCH_PROVIDERS=duckduckgo-html,searxng
# SEARXNG_URL=http://127.0.0.1:8080

# Experimental direct Google mode. Google often serves JavaScript-only or CAPTCHA
# pages to automation, so it is not a dependable zero-cost choice.
# SEARCH_PROVIDER=google-html

# Optional paid/reliable Google-results provider.
# SEARCH_PROVIDER=serper
# SERPER_API_KEY=replace-me

# Legacy alternative: Google Programmable Search JSON API.
# SEARCH_PROVIDER=google-cse
# GOOGLE_API_KEY=replace-me
# GOOGLE_CSE_ID=replace-me

# Optional fetch policy. Public web hosts are allowed by default; local and private
# network addresses are always blocked.
# WEB_ALLOWLIST=docs.example.com,*.wikipedia.org
# WEB_BLOCKLIST=example.com
# MAX_PAGE_CHARS=15000
# FETCH_TIMEOUT_MS=15000
